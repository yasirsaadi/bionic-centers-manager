// فحصُ أنواعٍ لملفّات الاختبار — `tsconfig.json` يستثنيها، فبقيت خارج
// `npm run check` تماماً. وهذا ما جعل كسراً حقيقياً في
// `server/ai_page_guide.test.ts` (إعادةُ تعريف متغيّرات في النطاق نفسِه)
// يعيش من PR #358 إلى #364 بلا أن يراه أحد: الملفّ لا يُترجَم، فالحزمةُ
// **لا تعمل أصلاً** بينما `npm run check` يبقى أخضر.
//
// يُشغَّل عبر `npm run check:tests` (لا `tsc -p` مباشرةً) — فالمُشغِّل
// يفرّق بين ملفّاتٍ يجب أن تكون نظيفة تماماً وديونٍ قديمة مسمّاة.
{
  "extends": "./tsconfig.json",
  // الفارقُ الوحيد عن الأساس: لا استثناءَ لملفّات الاختبار.
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions": {
    // الأساسُ بلا `target`، فيفترض TypeScript ES5 ويشكو من أنماطٍ حديثة
    // (`matchAll`، رايةُ `s`، تعريفُ دالّةٍ داخل كتلة) يشغّلها tsx على
    // Node 20 بلا مشكلة. فالهدفُ هنا يصف ما يعمل فعلاً.
    "target": "ES2022",
    // ذاكرةٌ مستقلّة كي لا يفسد هذا الفحصُ ذاكرةَ `npm run check`.
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo.tests"
  }
}
